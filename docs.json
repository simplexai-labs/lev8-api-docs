{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Lev8 API",
  "description": "Search for entities and contact details from your application.",
  "api": {
    "openapi": [
      "openapi.yaml"
    ],
    "mdx": {
      "server": "https://app.lev8.com"
    },
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "all",
      "prefill": true
    }
  },
  "redirects": [
    {
      "source": "/api-reference/streaming-events",
      "destination": "/api-reference/task-results"
    }
  ],
  "seo": {
    "metatags": {
      "canonical": "https://docs.lev8.com"
    }
  },
  "colors": {
    "primary": "#9A6D00",
    "light": "#FFBB17",
    "dark": "#9A6D00"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart",
          "authentication"
        ]
      },
      {
        "group": "API reference",
        "pages": [
          {
            "group": "Entity Search",
            "root": "api-reference/entity-search",
            "pages": [
              "api-reference/entity-search/create-task",
              "api-reference/entity-search/status",
              "api-reference/entity-search/fetch"
            ]
          },
          {
            "group": "Contact Search",
            "root": "api-reference/contact-search",
            "pages": [
              "api-reference/contact-search/search"
            ]
          },
          {
            "group": "Credit balance",
            "root": "api-reference/credit-balance",
            "pages": [
              "api-reference/credit-balance/get-balance"
            ]
          }
        ]
      },
      {
        "group": "API behavior",
        "pages": [
          "api-reference/task-results",
          "api-reference/errors",
          "guides/idempotency",
          "guides/billing"
        ]
      },
      {
        "group": "MCP",
        "pages": [
          "mcp-reference",
          "agent-skills"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Lev8",
          "href": "https://lev8.com",
          "icon": "arrow-up-right-from-square"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Lev8",
        "href": "https://lev8.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/simplexai-labs",
      "website": "https://lev8.com"
    }
  }
}
