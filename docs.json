{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "lev8 API",
  "description": "Build live-web people and business intelligence into your product.",
  "api": {
    "mdx": {
      "server": "https://app.lev8.com"
    },
    "examples": {
      "languages": [
        "bash",
        "node",
        "python"
      ]
    }
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.lev8.com"
    }
  },
  "colors": {
    "primary": "#9A6D00",
    "light": "#FFBB17",
    "dark": "#9A6D00"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart",
          "authentication"
        ]
      },
      {
        "group": "API reference",
        "pages": [
          "api-reference/entity-search",
          "api-reference/contact-search",
          "api-reference/credit-balance"
        ]
      },
      {
        "group": "API behavior",
        "pages": [
          "api-reference/streaming-events",
          "api-reference/errors",
          "guides/idempotency",
          "guides/billing"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Lev8",
          "href": "https://lev8.com",
          "icon": "arrow-up-right-from-square"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Lev8",
        "href": "https://lev8.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/simplexai-labs",
      "website": "https://lev8.com"
    }
  }
}
